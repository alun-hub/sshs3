{
  "name": "sshs3",
  "version": "0.2.8",
  "description": "Modern cross-platform SSH, SFTP, and S3 client with smartcard and drag-and-drop support",
  "main": "dist-electron/index.js",
  "type": "module",
  "author": {
    "name": "Andreas Lundqvist",
    "email": "alun@alun.se"
  },
  "license": "MIT",
  "homepage": "https://unixkonsult.se/sshs3",
  "desktopName": "sshs3",
  "repository": {
    "type": "git",
    "url": "https://github.com/alun-hub/sshs3.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "^0.11.0",
    "lucide-react": "^1.46.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "win-ca": "^3.5.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  }
}
