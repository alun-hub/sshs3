{
  "appId": "com.sshs3.app",
  "productName": "sshs3",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "icon": "build/icon.png",
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "desktopName": "sshs3",
    "icon": "build/icons",
    "synopsis": "Modern SSH, SFTP, and S3 client with smartcard and drag-and-drop support"
  },
  "win": {
    "icon": "build/icon.png",
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
