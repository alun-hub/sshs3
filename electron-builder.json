{
  "appId": "com.sshs3.app",
  "productName": "sshs3",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "icon": "build/icon.png",
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": "build/icons",
    "synopsis": "Modern SSH, SFTP, and S3 client with smartcard and drag-and-drop support",
    "extraResources": [
      {
        "from": "build-resources/age/linux",
        "to": "age",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis",
      "portable",
      "zip"
    ],
    "artifactName": "${name}-${version}.${ext}",
    "extraResources": [
      {
        "from": "build-resources/vcxsrv",
        "to": "vcxsrv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/age/win",
        "to": "age",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${name}-Setup-${version}.${ext}",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "${name}-${version}-portable.${ext}",
    "splashImage": "build/portable-splash.bmp"
  },
  "publish": {
    "provider": "github",
    "owner": "alun-hub",
    "repo": "sshs3"
  },
  "electronFuses": {
    "runAsNode": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true
  }
}
