{
  "appId": "com.sshs3.app",
  "productName": "sshs3",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "icon": "build/icon.png",
  "linux": {
    "target": [
      "AppImage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": "build/icons",
    "synopsis": "Modern SSH, SFTP, and S3 client with smartcard and drag-and-drop support"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis",
      "portable"
    ],
    "artifactName": "${name}-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${name}-Setup-${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "alun-hub",
    "repo": "sshs3"
  }
}
